    {
      "id": "claim_09795bcffd6d43cf930ec5a9b991e644",
      "statement": "Results are persisted as raw JSON strings: ArDoCoApiResult holds traceLinks and inconsistencies as @JsonRawValue strings, buildJsonString() defines the exact stored shape {traceLinks, inconsistencies}, and AbstractService re-parses that same shape on retrieval, so the stored payload shape and the response shape must stay in sync; storing pre-converted JSON avoids re-converting the result on repeated queries.",
      "evidence": [
