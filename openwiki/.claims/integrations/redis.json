    {
      "id": "claim_0c516f054153439a8a95d1981fb39420",
      "statement": "CI (.github/workflows/ci.yml) runs mvn verify with SPRING_PROFILES_ACTIVE=docker next to a redis service container published on port 6379, but the test JVMs actually connect to Testcontainers-started Redis instances because the test classes override spring.data.redis.host/port via System.setProperty and @DynamicPropertySource, which take precedence over the profile property file.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/ci.yml#L13-L34",
