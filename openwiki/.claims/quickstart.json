          "version": "repo-lines-v1:sha256:e1c8b462954dbaec1982b906567215af4c4c346e97a87e58623d0180ff8a4916:"
        }
      ]
    },
    {
      "id": "claim_7856d36e6d0847328484dfc4c80a4000",
      "statement": "ResultService.waitForResult blocks on the in-flight CompletableFuture for at most tlr.timeout.seconds (60 by default); a timeout returns an empty Optional, which ResultController maps to HTTP 202 Accepted, while a ready result maps to 200 OK.",
      "evidence": [
        {
