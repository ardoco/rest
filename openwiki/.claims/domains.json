    {
      "id": "claim_db5ba0a36c634402b4440d422919b297",
      "statement": "The TraceLinkType enum binds each family to a trace-link label and ID prefix: SAD_CODE -> ardocodeResult, SAM_CODE -> arcotlResult, SAD_SAM -> swattrResult, SAD_SAM_CODE -> transarcResult, plus OTHER. It also carries an endpointName (ardocode/arcotl/swattr/transarc/other) used by the controller tests to derive the /api/<endpointName>/start paths, and fromId(id) recovers the type by matching the ID against the key prefixes, falling back to OTHER.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/api_response/TraceLinkType.java#L9-L41",
          "version": "repo-lines-v1:sha256:f667cff4f73cd1f9a3dee71d3584210c38769a9e12684aa5b3b7b82791f6e161:"
