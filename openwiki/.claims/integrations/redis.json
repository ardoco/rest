          "version": "repo-lines-v1:sha256:9766447fc01d02bd3cf2b7d8531618bacc6a37306963acbf1be328f805bea855:"
        }
      ]
    },
    {
      "id": "claim_b935047e6277488fb69c7e38de536e52",
      "statement": "Only the Redis host differs per deployment topology and is switched by Spring profile: application-docker.properties sets spring.data.redis.host=redis (the compose service hostname, matching the Dockerfile's ENV SPRING_PROFILES_ACTIVE=docker for container networking), while the default profile and application-local.properties both use 127.0.0.1; port 6379, empty username/password, and redis.time-to-live.hours=24 live only in the base application.properties and are not overridden by any profile.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L12-L12",
          "version": "repo-lines-v1:sha256:e54e84fbaa6dda909d2d6c2e21186071840c8808855650f1cd241e242a6eeb57:"
