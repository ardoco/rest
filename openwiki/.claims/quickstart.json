    {
      "id": "claim_1f5dea4cb5de404697e62c5613b71311",
      "statement": "getResultFromDatabase in AbstractService throws IllegalArgumentException when the key is absent from Redis, and rethrows ArdocoException when the stored payload starts with the 'Error: ' prefix, so failures persisted by the async run surface as errors on later retrieval attempts.",
      "evidence": [
