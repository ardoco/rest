    {
      "id": "claim_f1c40c0f62824929b21c3063c488bc72",
      "statement": "Each family's service fixes its payload shape through TraceLinkConverter: ArDoCodeService emits sentenceNumber/codeElementId/codeElementName (plus modelElementId/modelElementName on TransitiveTraceLink entries); ArCoTLService emits modelElementId/modelElementName/codeElementId/codeElementName; SwattrService and InconsistencyService emit sentenceNumber/modelElementName/modelElementId; and TransArCService calls result.getSadCodeTraceLinks() with the sad-code converter, so SAD_SAM_CODE responses use the same shape as SAD_CODE ones and changing that converter silently affects both families.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/converter/TraceLinkConverter.java#L34-L119",
          "version": "repo-lines-v1:sha256:3629bc9e4b535a72c6f6d89f5419c8015a98b85e2ae83e582b3fe925a8a477b7:"
