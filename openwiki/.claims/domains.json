    {
      "id": "claim_1c3f591bcef043648d40c6f90c50f5de",
      "statement": "The result retrieval endpoints GET /api/get-result/{id} and GET /api/wait-for-result/{id} are cross-family: because request IDs embed the TraceLinkType prefix and TraceLinkType.fromId matches on it, any family's result can be fetched by ID regardless of which start endpoint produced it. ResultService implements both operations against the in-flight registry and Redis, blocking on the registered future with tlr.timeout.seconds for waiting; unknown/expired IDs surface as errors and a cached pipeline failure surfaces as an ArdocoException.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/api_response/TraceLinkType.java#L34-L41",
