    {
      "id": "claim_fb812be2871744e78774ead39d89df95",
      "statement": "Runner setup happens before the dedup check, so a fully configured ArDoCo runner (including its temp output directory) is built on every start request even when the result is already cached and only needs to be read back; architecture_decisions.md documents this as an accepted disadvantage, with the alternative rejected because each runner's setUp takes different parameters.",
      "evidence": [
        {
          "resource": "repo://architecture_decisions.md#L58-L63",
          "version": "repo-lines-v1:sha256:51204f0595e4cc53fc0bf8caa4d7965d1f7a43608849d323409a9ff2221af705:"
        },
        {
