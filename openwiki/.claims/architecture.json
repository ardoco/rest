  "claims": [
    {
      "id": "claim_e1a41bcc193247cc9dd423aed927e77f",
      "statement": "The ArDoCo REST application starts without a SQL datasource — ArDoCoRestApplication excludes DataSourceAutoConfiguration and enables @EnableAsync with OpenAPI metadata — and all durable state lives in Redis via the LettuceConnectionFactory and RedisTemplate beans that ApplicationConfig configures from the spring.data.redis host/port properties.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/ApplicationConfig.java#L17-L60",
          "version": "repo-lines-v1:sha256:196d13647b1d3f30be25f84452e54fda3bbc20efe5098df4d473f1cf1c571dd6:"
        },
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/ArDoCoRestApplication.java#L15-L18",
          "version": "repo-lines-v1:sha256:b760d9cd7797de42535581d4d8fd538829e96d408dd2bd78e35eed2db7fb42a9:"
        }
      ]
    },
    {
      "id": "claim_18c5d759cd3e4f238e021f8c31b1388a",
      "statement": "Each runner-family controller converts multipart uploads to local Files, parses the optional additionalConfigs JSON, generates the request ID, and instantiates and configures the ArDoCo runner itself before delegating to the service; runner setup therefore happens before the cache check and runs even when the result is already stored, a documented trade-off kept because the per-runner setUp signatures would otherwise require a generics-heavy unified service interface.",
      "evidence": [
        {
          "resource": "repo://architecture_decisions.md#L48-L63",
          "version": "repo-lines-v1:sha256:0fb42112a8da0cdb270c83f029e9e48d2111a6069678b3cf2e02f38fb50a84b2:"
        },
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/controller/ArDoCodeController.java#L141-L150",
          "version": "repo-lines-v1:sha256:2591489db94770a6977146ecb8a4e630930ae7db11305f4370c7ac6789358926:"
        },
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/controller/ArDoCodeController.java#L87-L94",
          "version": "repo-lines-v1:sha256:69e6a2bb41a57a24c4933dd410a2b42e881d0db16e659f18b4ddf6a314d1eef5:"
        }
      ]
    },
    {
      "id": "claim_b5a8e1a368a1482b8e49f4e044575f67",
      "statement": "Only direct ArDoCo invocation is asynchronous: multipart conversion, hashing, and runner setup run synchronously in the request thread so clients get fast feedback on invalid input; the REST layer only rejects empty or null files (delegating file-type validation to ArDoCo itself), and runner output directories are throwaway temp directories created via Files.createTempDirectory.",
      "evidence": [
        {
          "resource": "repo://architecture_decisions.md#L39-L41",
          "version": "repo-lines-v1:sha256:1d0f4be5fbadf7f6b1ed71504ab187eb0fbb74b937bd8473b80eded490ac08d9:"
        },
        {
