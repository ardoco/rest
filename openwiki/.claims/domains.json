    {
      "id": "claim_5a53409caea942af849c31d4b6ed7b46",
      "statement": "InconsistencyController reuses the SAD_SAM trace-link type but overrides generateRequestId to produce IDs with the prefix swattrResultInconsistency (TraceLinkType.SAD_SAM.getKeyPrefix() + \"Inconsistency:\" + projectName + hash), so inconsistency results are keyed separately from plain SWATTR results even though both share the same TraceLinkType, prefix family, and input set.",
      "evidence": [
