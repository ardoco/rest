        }
      ]
    },
    {
      "id": "claim_8683aff3ffec456082fb732f68c50401",
      "statement": "Each start endpoint's controller performs four synchronous steps before contacting the service: FileConverter.convertMultipartFileToFile writes each multipart upload to java.io.tmpdir under its original filename and rejects null or empty uploads, AbstractController.parseAdditionalConfigs parses the optional additionalConfigs JSON into a TreeMap (invalid JSON raising FileConversionException), AbstractController.generateRequestId builds the content-based request ID, and the runner is instantiated and set up with a throwaway Files.createTempDirectory output directory.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/controller/AbstractController.java#L131-L157",
          "version": "repo-lines-v1:sha256:979fdfb5048cc99343fc92a84db2f64eb2a921ba3fd3f755acb84bb9fe4ef28b:"
