    {
      "id": "claim_9ed3f975733348bf978e7da679ed2428",
      "statement": "The REST layer does not implement trace-link recovery itself; it delegates to external ArDoCo libraries declared in pom.xml — io.github.ardoco.core:common, io.github.ardoco.id:pipeline-id, io.github.ardoco.tlr:pipeline-tlr, and io.github.ardoco.tlr:text-preprocessing — all at the ArDoCo snapshot version ${ardoco.version}.",
      "evidence": [
        {
          "resource": "repo://pom.xml#L41-L61",
          "version": "repo-lines-v1:sha256:74534ea6cb7f5970505b6d158f5e035b58fb3c4268f5c5b5159a5d07083e9f56:"
