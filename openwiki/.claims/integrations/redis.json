    {
      "id": "claim_b827257e6b724842b66b157863d773fb",
      "statement": "ApplicationConfig carries @EnableRedisRepositories, but the api/repository package defines no Redis entities (@RedisHash) and no Spring Data repository interfaces — its only three types are the DatabaseAccessor interface, the RedisAccessor @Repository (template-based, not a Spring Data repository), and CurrentlyRunningRequestsRepository, which is a singleton in-memory ConcurrentHashMap of CompletableFuture<ArDoCoApiResult> tracking in-flight runs; all Redis persistence goes through RedisTemplate string operations.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/ApplicationConfig.java#L17-L20",
          "version": "repo-lines-v1:sha256:e6a773a31f4d42b068d50b3e7a82da2ded344c5be01a65a6693dfb1052f1c8f7:"
