    {
      "id": "claim_d76dd05e06dd4cbc94f58d1d1e2b7b36",
      "statement": "GlobalExceptionHandler centrally maps FileNotFoundException, FileConversionException, and IllegalArgumentException to 422 Unprocessable Content, ArdocoException and any other uncaught Exception to 500 Internal Server Error, and TimeoutException to 408 Request Timeout, each producing an ErrorResponse body with timestamp, status, and message.",
