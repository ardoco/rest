        }
      ]
    },
    {
      "id": "claim_26ee278936854d9282e83bc9d1280291",
      "statement": "Successful pipeline runs store one plain string per request ID: the raw JSON payload built by ArDoCoApiResult.buildJsonString() ({\"traceLinks\":...,\"inconsistencies\":...}); AbstractService.getResultFromDatabase later parses the traceLinks and inconsistencies fields out of that string with Jackson.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/api_response/ArDoCoApiResult.java#L59-L61",
          "version": "repo-lines-v1:sha256:fa56e9a057b94f70a0bf2c387d1ed0d56cab5f6866050f4038eda54bf71ded67:"
