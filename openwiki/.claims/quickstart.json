    {
      "id": "claim_1f5dea4cb5de404697e62c5613b71311",
      "statement": "getResultFromDatabase in AbstractService throws IllegalArgumentException when the key is absent from Redis, rethrows ArdocoException when the stored payload is null or starts with the 'Error: ' prefix, and otherwise re-parses the stored raw JSON with JsonMapper.readTree, manually extracting the traceLinks and inconsistencies arrays into an ArDoCoApiResult, so failures persisted by the async run surface as errors on later retrieval attempts and the DTO shape is decoupled from bean deserialization.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/service/AbstractService.java#L58-L83",
          "version": "repo-lines-v1:sha256:2623a07f168236b357569879306862ce01917d96e100fb1b2fe434cacb9d4723:"
        }
      ]
    },
    {
      "id": "claim_ec6188115e154d079528ab76399a8847",
      "statement": "Controllers are responsible for setting up the ArDoCo runner themselves: each start endpoint converts multipart uploads to temporary files, parses additionalConfigs, generates the request ID, constructs and configures the concrete runner (e.g. Ardocode with CodeConfiguration and a temporary output directory), and only then delegates to the service layer.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/controller/ArDoCodeController.java#L141-L150",
          "version": "repo-lines-v1:sha256:2591489db94770a6977146ecb8a4e630930ae7db11305f4370c7ac6789358926:"
