  "claims": [
    {
      "id": "claim_9f9cefc4d1f0460087f307e680a5fb71",
      "statement": "ResultController exposes two cross-family retrieval endpoints under /api: GET /api/get-result/{id} (non-blocking) and GET /api/wait-for-result/{id} (blocking up to the wait budget). Both map a present Optional<ArDoCoApiResult> to 200 OK with ResultMessages.RESULT_IS_READY and an empty one to 202 Accepted — with RESULT_NOT_READY for get-result and REQUEST_TIMED_OUT for wait-for-result — by constructing an ArdocoResultResponse whose own status field becomes the ResponseEntity status.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/controller/ResultController.java#L36-L97",
          "version": "repo-lines-v1:sha256:cdddfbfab2d05a13f1a87488b54ad952be739eaa95a5e2b438dc01490998a8da:"
        },
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/messages/ResultMessages.java#L9-L14",
          "version": "repo-lines-v1:sha256:af1c800d91e9055ace44423acfc7f4b47d3297ef778d2862305d102b1f9e2c7b:"
        }
      ]
    },
    {
      "id": "claim_b77b9bea09304ee68439cc4b82b501e1",
      "statement": "ResultService.getResult returns Optional.empty() without consulting the database while the request ID is registered in CurrentlyRunningRequestsRepository (resultIsOnItsWay); otherwise it returns getResultFromDatabase(id). ResultService.waitForResult blocks on the registered future when the request is in flight, and otherwise reads the finished result directly from Redis — so a run that completed between the start response and the wait call is served from the database without waiting.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/repository/CurrentlyRunningRequestsRepository.java#L56-L58",
          "version": "repo-lines-v1:sha256:1e51c559bc347eb6e03b3bb105fa5b1277c3923bd6208a1d23861f1d6cb15038:"
        },
        {
