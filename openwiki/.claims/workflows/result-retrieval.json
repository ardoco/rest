          "version": "repo-lines-v1:sha256:c43f62708733d6f93cba2cf876ac903a249f20cfcb5aee6e92dd448cf3d6dad3:"
        },
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/service/ResultService.java#L41-L62",
          "version": "repo-lines-v1:sha256:674c3b7b48aa3263f1c4769f05c06965bd734cba15b941e0e333fc0a71d2a9dc:"
        }
      ]
    },
    {
      "id": "claim_10201e1d1e92421ebbe29d36b7f936d5",
      "statement": "ResultService.waitForResultHelper blocks on CompletableFuture.get(secondsUntilTimeout, TimeUnit.SECONDS), where secondsUntilTimeout is injected from the tlr.timeout.seconds property (60 by default in application.properties). A java.util.concurrent.TimeoutException is caught and converted into Optional.empty(), which the controllers translate into 202 Accepted; ExecutionException and InterruptedException are wrapped in ArdocoException, which surfaces as HTTP 500.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/service/ResultService.java#L70-L80",
          "version": "repo-lines-v1:sha256:7ea2f7a987e7f38ddcecd0c492e072e7a8fa98b832496a363be2094bb080ad45:"
        },
        {
          "resource": "repo://src/main/resources/application.properties#L20-L21",
          "version": "repo-lines-v1:sha256:0140bf9f8ec757d87574cb76ed2f44a5b5c59901802eb674fd9d962d86b32704:"
        }
      ]
    },
    {
      "id": "claim_2e68eabf2694401f81d7ef9e9e207219",
      "statement": "AbstractService.getResultFromDatabase throws IllegalArgumentException(String.format(...No result with key %s found., id)) when the ID does not exist in the database (DatabaseAccessor.keyExistsInDatabase), and GlobalExceptionHandler maps IllegalArgumentException to 422 Unprocessable Content — so an unknown or TTL-expired result ID yields 422 on both retrieval endpoints, distinct from the 202 of a still-running pipeline.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/exception/GlobalExceptionHandler.java#L85-L91",
          "version": "repo-lines-v1:sha256:412d1c33f0f92cfee435306bbdb3b31a202f2b4cd70065f5b1152c909cc7fe7d:"
        },
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/service/AbstractService.java#L58-L66",
          "version": "repo-lines-v1:sha256:7fcce0349951b76b7e1d7130350be586c8f3a553ef4af22fa5c6a0d6f71708b0:"
        }
      ]
    },
    {
      "id": "claim_9fdb8d7ad2df4cb2a9b79d0ce15518bd",
      "statement": "AbstractService.getResultFromDatabase throws ArdocoException when the stored value is null or starts with the ERROR_PREFIX 'Error: ', and GlobalExceptionHandler maps ArdocoException to HTTP 500. Because a failed pipeline stored an 'Error: '-prefixed marker in Redis under the request ID (with the normal TTL) instead of leaving the key absent, every subsequent retrieval surfaces the stored failure as a 500 until the key expires.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/exception/GlobalExceptionHandler.java#L71-L77",
          "version": "repo-lines-v1:sha256:457c721813be43418a03c95e2d617c797dc713863fda7064cfdd0c7e12724833:"
        },
