    {
      "id": "claim_acb5c9acb8a8434a8ca9ff8285fdb7fa",
      "statement": "The stored result is re-parsed by name: getResultFromDatabase reads the stored JSON string, extracts the traceLinks and inconsistencies nodes via JsonNode.path(name).toString(), and rebuilds an ArDoCoApiResult whose @JsonRawValue fields embed the raw JSON verbatim in the response. The stored shape is exactly ArDoCoApiResult.buildJsonString() output ({...traceLinks...,...inconsistencies...}); renaming either side's keys breaks retrieval, and a parse failure is wrapped as ArdocoException (HTTP 500).",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/api_response/ArDoCoApiResult.java#L11-L61",
          "version": "repo-lines-v1:sha256:fdf8fa8670b0ba582fe5ca7fad04a7b42347defaa417b26d6859a71c7fea6e1e:"
        },
