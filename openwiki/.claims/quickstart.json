    {
      "id": "claim_95d778176be54a56854ba6dfecb595b2",
      "statement": "Request IDs are built as traceLinkType.getKeyPrefix() + ':' + projectName + hash, and because results are stored in Redis under the request ID, the TraceLinkType key prefix embedded in each ID doubles as the per-family Redis key namespace.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/api_response/TraceLinkType.java#L9-L41",
          "version": "repo-lines-v1:sha256:f667cff4f73cd1f9a3dee71d3584210c38769a9e12684aa5b3b7b82791f6e161:"
        },
