    {
      "id": "claim_a2c278774875443a88aee2a629e125ff",
      "statement": "Failure provenance determines the HTTP code: input failures thrown synchronously in the controller/converter layer (empty or null multipart files, failed transfers, invalid additionalConfigs JSON, unknown model format strings) surface immediately as 422 before any pipeline starts, whereas pipeline failures are caught in runPipelineAsync which stores an \"Error: \" prefixed marker in Redis under the request ID and throws ArdocoException — the failure resurfaces as 500 both to clients blocked in waitForResult and to later queries reading the error marker via getResultFromDatabase, persisting until the Redis TTL expires, while unknown or expired IDs raise IllegalArgumentException and thus 422.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/controller/AbstractController.java#L144-L157",
          "version": "repo-lines-v1:sha256:1526a661711a6da944c92f3401bc080d26d0c6882bda22a9697ce8a8e7496936:"
