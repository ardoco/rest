    {
      "id": "claim_9ad09da772954c148203f94e8e8dcedf",
      "statement": "The raw result payload round-trips through three serialization points that must stay in sync: runPipelineAsync stores traceLinkJson.buildJsonString() (composed exactly as {\"traceLinks\":<raw>,\"inconsistencies\":<raw>}) in Redis, getResultFromDatabase re-parses the stored JSON and re-extracts the traceLinks and inconsistencies nodes by name into a fresh ArDoCoApiResult, and the envelope then embeds those strings via @JsonRawValue — renaming either the stored keys, the node names read back, or the envelope properties breaks retrieval or the client-visible shape, and stored values must be valid JSON.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/api_response/ArDoCoApiResult.java#L59-L61",
