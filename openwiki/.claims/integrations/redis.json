    {
      "id": "claim_15cc1807b1ac46cb8c9fec380769bea6",
      "statement": "RedisAccessor reads its expiry from redis.time-to-live.hours (24 in application.properties) and writes every result through opsForValue().set(id, value, timeToLive, TimeUnit.HOURS), so every stored entry expires after 24 hours; reads are thin wrappers over opsForValue().get, null-safe hasKey, and delete.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/repository/RedisAccessor.java#L17-L44",
          "version": "repo-lines-v1:sha256:1295a3d87221c2856d9161195adeff80e0abdb702bc8d46f43403094d3feeb63:"
