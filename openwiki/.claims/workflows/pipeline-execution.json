    {
      "id": "claim_fd80baca05a3459ba2fb2bc4a2ee5de3",
      "statement": "On the worker thread, runPipelineAsync calls runner.run(), converts the ArdocoResult through the abstract per-family convertResultToJsonString (TraceLinkConverter, plus InconsistencyConverter for inconsistencies), and stores the raw JSON string built by ArDoCoApiResult.buildJsonString (a traceLinks/inconsistencies object) under the request ID with the 24-hour TTL from redis.time-to-live.hours; conversion happens once per run and later retrievals re-parse the stored string.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/api_response/ArDoCoApiResult.java#L59-L61",
          "version": "repo-lines-v1:sha256:fa56e9a057b94f70a0bf2c387d1ed0d56cab5f6866050f4038eda54bf71ded67:"
        },
