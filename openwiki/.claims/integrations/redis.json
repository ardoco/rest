    {
      "id": "claim_8d94306f9b69475f8128cb438b17d593",
      "statement": "Because 6379 is only exposed (never published) in the compose template, an application run on the host with the default or local profile (127.0.0.1:6379) cannot reach the containerized Redis unmodified — it needs a published host port in its local docker-compose.yml or a host-local Redis — while the full-docker topology (app container plus docker profile) works as-is.",
      "evidence": [
        {
          "resource": "repo://docker-compose-template.yaml#L1-L25",
