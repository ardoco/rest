    {
      "id": "claim_7e93b455b92a42f9be6230fa99851960",
      "statement": "ArDoCo REST is a Spring Boot application whose entrypoint ArDoCoRestApplication uses @EnableAsync and excludes DataSourceAutoConfiguration, and exposes four runner families via controllers at /api/ardocode (sad-code), /api/arcotl (sam-code), /api/swattr (sad-sam), and /api/transarc (sad-sam-code), plus inconsistency detection at /api/find-inconsistencies and shared retrieval endpoints /api/get-result/{id} and /api/wait-for-result/{id} in ResultController.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/ArDoCoRestApplication.java#L15-L18",
          "version": "repo-lines-v1:sha256:b760d9cd7797de42535581d4d8fd538829e96d408dd2bd78e35eed2db7fb42a9:"
