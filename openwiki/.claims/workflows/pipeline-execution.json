  "claims": [
    {
      "id": "claim_d114033044834151819b111b22f976ff",
      "statement": "The /start and /start-and-wait endpoints answer HTTP 200 immediately — returning the cached result when one is available and otherwise the message 'The result is being processed and can be queried using the id.' — because only the direct ArDoCo invocation (runner.run inside runPipelineAsync) is asynchronous; multipart conversion, hashing, config parsing, and runner setup run synchronously in the request thread so input problems surface before any pipeline work (unless the cached value is an error marker, which surfaces as an ArdocoException).",
      "evidence": [
        {
          "resource": "repo://architecture_decisions.md#L78-L80",
          "version": "repo-lines-v1:sha256:dcef64a712a607aee16e5373443e8addde2705527b6e613c2aca4c1e0f9fed98:"
        },
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/controller/AbstractController.java#L85-L95",
          "version": "repo-lines-v1:sha256:575f7ce5dcf5e2703707be449242cf956c8ec2859f67b9fb5cfbd4b6f241380e:"
        },
        {
