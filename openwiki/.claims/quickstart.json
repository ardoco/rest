          "version": "repo-lines-v1:sha256:16661adc814183651c92285751a893ee3fb1479eedd748000386204ccb7d2fe7:"
        }
      ]
    },
    {
      "id": "claim_57022f7284d344d09b708feee36fb51e",
      "statement": "The centralized GlobalExceptionHandler (@ControllerAdvice) maps exceptions to HTTP statuses and ErrorResponse bodies: FileNotFoundException and FileConversionException to 422 Unprocessable Content, ArdocoException to 500 Internal Server Error, IllegalArgumentException to 422, the custom TimeoutException to 408 Request Timeout, and any other Exception to a generic 500 handler.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/exception/GlobalExceptionHandler.java#L52-L107",
          "version": "repo-lines-v1:sha256:4a18ef56fe395005213957b9a18a1e002441e904f764b3114611aa986b5b8ac1:"
        }
      ]
    },
