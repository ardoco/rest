          "version": "repo-lines-v1:sha256:adaa90093e75337920e4ff11eddf67fcf63b84ca58f218cff0e2cfe14860aa81:"
        }
      ]
    },
    {
      "id": "claim_f3ebe18f5bfd468ca010c9f7fd69dd75",
      "statement": "Failed pipeline runs cache their error like a result: AbstractRunnerTLRService.runPipelineAsync stores \"Error: \" + message under the ID with the normal TTL, and on the read side getResultFromDatabase throws ArdocoException when the stored value is null or starts with the \"Error: \" prefix (AbstractService.ERROR_PREFIX), or IllegalArgumentException when the key is absent entirely — so within the TTL window a cached failure surfaces as an exception instead of a re-run.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/service/AbstractRunnerTLRService.java#L114-L118",
          "version": "repo-lines-v1:sha256:566c35095660765227472bb8fcb557418f402fba5069c0b537d2b3b01bd249e1:"
        },
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/service/AbstractService.java#L31-L66",
          "version": "repo-lines-v1:sha256:61aa2764a440220f334fb55eee4c929fd8b0160cdf36ffe1f3d7eace2db6e03a:"
        }
      ]
    },
    {
      "id": "claim_dd4a3a8fbeb942788397de221a8c992c",
      "statement": "ApplicationConfig owns the Redis connection: it reads spring.data.redis.host and spring.data.redis.port via @Value, builds a LettuceConnectionFactory from an explicit RedisStandaloneConfiguration seeded with those values (the in-code comment notes this is required for the app to work with docker), and defines the redisTemplate bean that RedisAccessor injects.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/ApplicationConfig.java#L22-L59",
          "version": "repo-lines-v1:sha256:5caff484997db7ef32880a5c87361ab31a48b711f537db683a38416d6b683580:"
        },
