    {
      "id": "claim_caae05507b6b4a04ba1e34efb7327c6f",
      "statement": "The optional additionalConfigs JSON parameter is parsed by AbstractController.parseAdditionalConfigs into a TreeMap<String, String> (invalid JSON raises FileConversionException), converted to an ImmutableSortedMap with SortedMaps.immutable.withSortedMap, and passed to the runner's setUp — the ArDoCo libraries interpret the configuration keys, so the REST layer has no schema for them; additionalConfigs is deliberately not part of the request-ID hash, so config-only changes collide on the same ID and reuse the cached result.",
      "evidence": [
        {
          "resource": "repo://architecture_decisions.md#L82-L84",
          "version": "repo-lines-v1:sha256:a7eed1d40b49106534da65810da78230ad0e1d72b858c411e65e7dad7fd90309:"
        },
        {
