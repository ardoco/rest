          "version": "repo-lines-v1:sha256:69e6a2bb41a57a24c4933dd410a2b42e881d0db16e659f18b4ddf6a314d1eef5:"
        }
      ]
    },
    {
      "id": "claim_9c0a98f3937b463a8f2e294e07b9d718",
      "statement": "AbstractRunnerTLRService.runPipeline dispatches a new run only when the request ID is neither in Redis (resultIsInDatabase via DatabaseAccessor.keyExistsInDatabase) nor in the in-flight registry (resultIsOnItsWay via CurrentlyRunningRequestsRepository.containsRequest); it returns the stored result directly when the key exists and Optional.empty otherwise. The check-then-act sequence is not atomic, so two concurrent first requests for the same new ID can each dispatch a run before either future is registered, converging only because the later Redis saveResult overwrites the earlier value.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/repository/RedisAccessor.java#L26-L30",
          "version": "repo-lines-v1:sha256:c5631743329d8f003fce26207ca8a9be2efb032c5cdb5af1f1fd5d9d774bc246:"
        },
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/service/AbstractRunnerTLRService.java#L83-L92",
          "version": "repo-lines-v1:sha256:5e8428ca1e5f1259866bc20abc8cfbf6a42fec3c0ee5cba8a6c9b5589b744a11:"
        },
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/service/AbstractService.java#L88-L100",
          "version": "repo-lines-v1:sha256:c43f62708733d6f93cba2cf876ac903a249f20cfcb5aee6e92dd448cf3d6dad3:"
        }
      ]
