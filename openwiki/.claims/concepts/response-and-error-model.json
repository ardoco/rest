    {
      "id": "claim_237a74b9ed984b7881e7ac55e50d57b6",
      "statement": "GlobalExceptionHandler is a @ControllerAdvice extending ResponseEntityExceptionHandler that maps the API's own FileNotFoundException and FileConversionException and IllegalArgumentException to 422 UNPROCESSABLE_CONTENT, ArdocoException to 500 INTERNAL_SERVER_ERROR, the custom TimeoutException to 408 REQUEST_TIMEOUT, and any other Exception to 500; it builds an ErrorResponse whose own status is reused as the ResponseEntity status, and because the API's FileNotFoundException shadows java.io.FileNotFoundException the 422 mapping intercepts empty-or-missing uploaded files rather than JDK file I/O errors.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/exception/FileNotFoundException.java#L8-L16",
