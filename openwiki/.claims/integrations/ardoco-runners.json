    {
      "id": "claim_f3f137ecfc704da39e7846c8d89ff477",
      "statement": "The REST layer performs no file-type validation beyond the empty-file check in FileConverter — whether the uploaded file is a valid PCM, UML, or OpenAM model is checked by ArDoCo itself when the runner runs; this is documented (\"So far no file checks have been implemented. This is left to ArDoCo itself\"), so the REST layer only rejects empty files (422) and lets ArDoCo surface format errors as pipeline failures (500).",
      "evidence": [
        {
          "resource": "repo://architecture_decisions.md#L39-L41",
          "version": "repo-lines-v1:sha256:1d0f4be5fbadf7f6b1ed71504ab187eb0fbb74b937bd8473b80eded490ac08d9:"
