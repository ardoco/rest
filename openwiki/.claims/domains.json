    {
      "id": "claim_a1bb159451324940b6b84357a8f5a670",
      "statement": "The ArDoCo REST API exposes five trace-link recovery/inconsistency-detection domains, each with a dedicated controller and service: ArDoCode (sad-code) at /api/ardocode, ArCoTL (sam-code) at /api/arcotl, SWATTR (sad-sam) at /api/swattr, TransArC (sad-sam-code) at /api/transarc, and InconsistencyDetection (sad-sam + inconsistency detection) at /api/find-inconsistencies. Each family controller exposes POST /start and /start-and-wait endpoints consuming multipart/form-data.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/controller/ArCoTLController.java#L44-L58",
          "version": "repo-lines-v1:sha256:352e25e518f8b432dc31b339e1b0f3e17c6305021e437414e7725dc272cbaec2:"
