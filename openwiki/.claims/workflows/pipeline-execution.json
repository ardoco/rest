    {
      "id": "claim_c3c805c8d5ab4081bf29addad25ae9ae",
      "statement": "A dispatched run is wrapped in CompletableFuture.supplyAsync (ForkJoin common pool) and registered under the request ID in the singleton CurrentlyRunningRequestsRepository, a ConcurrentHashMap of futures; the registration lets ResultService.getResult skip the database call while a run is in flight and lets waitForResult block on the future with the tlr.timeout.seconds bound instead of polling Redis. The dispatch does not use Spring @Async handler methods, even though ArDoCoRestApplication enables @Async at the application level.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/ArDoCoRestApplication.java#L16-L17",
          "version": "repo-lines-v1:sha256:9ab8e97ee2cb8d61e2e330f9e5439d505d5b3c51779fec4de12fa095f57bdac3:"
        },
        {
