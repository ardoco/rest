    {
      "id": "claim_ffd3d9ab2aae4a69bb3b187e020ba2fd",
      "statement": "The Redis-backed tests (AbstractTLRControllerTest and RedisAccessorTest) are @SpringBootTest classes that start a redis:7.0-alpine GenericContainer in @BeforeAll and bind the application's Redis connection by overriding spring.data.redis.host and spring.data.redis.port (via System.setProperty, plus @DynamicPropertySource in RedisAccessorTest), so they require a Docker daemon but do not depend on the redis service container declared in the CI workflow; the controller tests boot the full application on a random port and drive it via TestRestTemplate.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/ci.yml#L28-L34",
          "version": "repo-lines-v1:sha256:1c58bee7000771395cff2b0265ba545da469fe5d633ec99cbb77903fbd350134:"
