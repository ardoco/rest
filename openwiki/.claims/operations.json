    {
      "id": "claim_bd9974c7b0ee4741bc8166b96c81d6fb",
      "statement": "At runtime /start answers HTTP 200 immediately with either a cached result or the requestId and a being-processed message; /start-and-wait and /api/wait-for-result/{id} block up to tlr.timeout.seconds (60s) and return 200 with the result or 202 when the wait times out; /api/get-result/{id} returns 202 while the pipeline is in flight; results expire from Redis after redis.time-to-live.hours (24h) so a repeated request re-runs the pipeline; and a failed pipeline stores an \"Error: \"-prefixed message under the request ID with the same TTL so a retry within the window surfaces the cached failure.",
      "evidence": [
        {
          "resource": "repo://src/main/java/edu/kit/kastel/mcse/ardoco/tlr/rest/api/controller/AbstractController.java#L85-L120",
